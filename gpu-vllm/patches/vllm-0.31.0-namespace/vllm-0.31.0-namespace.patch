+class HarmonyFunctionNames(frozenset):
+    """Recipient allowlist with an exact, request-local namespace mapping."""
+
+    def __new__(cls, names, namespace_names):
+        instance = super().__new__(cls, names)
+        instance.namespace_names = namespace_names
+        return instance
+
