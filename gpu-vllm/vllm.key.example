# Copy to ~/vllm.key, chmod 600, and replace values locally. Never commit keys.
export HF_TOKEN=
export VLLM_API_KEY=
# Client SHOGUN_VLLM_API_KEY must have the same value as VLLM_API_KEY.
export SHOGUN_VLLM_API_KEY="$VLLM_API_KEY"
export SHOGUN_VLLM_BASE_URL=http://127.0.0.1:8003/v1
# On the Mac using LOCAL_PORT=32424, override the last URL with:
# export SHOGUN_VLLM_BASE_URL=http://127.0.0.1:32424/v1
